# 当前文件：BigOrange Docker Compose 的用户配置模板。
BIGORANGE_IMAGE_NAMESPACE=papersman

BIGORANGE_HTTP_BIND=0.0.0.0
BIGORANGE_HTTP_PORT=18080
BIGORANGE_AI_PROVIDER=google
BIGORANGE_FORWARD_CLIENT_IP=false
ENABLE_GENERAL_UNBLOCK=false

# 同时填写这两项后，QQ 登录态会加密保存到 qq-api-state 卷并跨重启恢复。
QQ_AUTH_SESSION_PATH=
QQ_SESSION_SECRET=

GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_API_MODEL=gpt-4o
OPENAI_API_TEMPERATURE=0.7

BIGORANGE_SYNC_BIND=0.0.0.0
BIGORANGE_SYNC_PORT=13000
BIGORANGE_SYNC_DATA_DIR=./data/sync
SYNC_TOKEN=
DASHBOARD_TOKEN=
